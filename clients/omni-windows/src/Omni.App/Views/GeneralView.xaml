<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Omni.App.Views.GeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:components="using:Omni.App.Components">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="18" MaxWidth="640">

            <!-- An incompatible daemon replaces the whole pane: there is nothing
                 useful to do until the app is updated, so no controls are shown.
                 Same as the macOS General pane. -->
            <controls:InfoBar
                IsOpen="{x:Bind ViewModel.IsIncompatible, Mode=OneWay}"
                IsClosable="False"
                Severity="Error"
                Title="Update required"
                Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

            <StackPanel Spacing="18"
                        Visibility="{x:Bind ViewModel.ShowDaemonSections, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                <!-- Section: Daemon -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Daemon" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="12">
                            <!-- Status: label left, state + glyph right. -->
                            <Grid ColumnSpacing="16" MinHeight="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Status" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <FontIcon FontSize="16"
                                              Glyph="{x:Bind ViewModel.Connection, Mode=OneWay, Converter={StaticResource ConnectionStatusGlyph}}"
                                              Foreground="{x:Bind ViewModel.Connection, Mode=OneWay, Converter={StaticResource ConnectionStatusBrush}}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Start"
                                        IsEnabled="{x:Bind ViewModel.CanStartDaemon, Mode=OneWay}"
                                        Click="OnStartClick" />
                                <Button Content="Stop"
                                        IsEnabled="{x:Bind ViewModel.CanStopDaemon, Mode=OneWay}"
                                        Click="OnStopClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Section: Info — only while there is a daemon to describe. -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Info" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="12">
                            <components:LabeledRow Label="Input capture"
                                                   Value="{x:Bind ViewModel.CaptureStatus, Mode=OneWay}" />
                            <components:LabeledRow Label="Port"
                                                   Value="{x:Bind ViewModel.PortText, Mode=OneWay}" />
                            <components:LabeledRow Label="Fingerprint"
                                                   Value="{x:Bind ViewModel.Fingerprint, Mode=OneWay}"
                                                   Monospaced="True"
                                                   Selectable="True" />
                            <components:LabeledRow Label="Version"
                                                   Value="{x:Bind ViewModel.DisplayVersion, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.HasDaemonVersion, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Whatever the last command failed with. -->
                <controls:InfoBar
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Warning"
                    Title="Something went wrong"
                    Message="{x:Bind ViewModel.LastError, Mode=OneWay}" />

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
