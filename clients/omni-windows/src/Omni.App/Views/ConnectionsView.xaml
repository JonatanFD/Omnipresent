<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Omni.App.Views.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ipc="using:Omni.Ipc"
    xmlns:components="using:Omni.App.Components">

    <!-- Connect, incoming requests, sessions, peers and layout all live here,
         because they are all about managing peers — the same grouping and the
         same order as the macOS Connections pane. -->
    <Grid>
        <!-- With no daemon and nothing remembered, the pane is a single centred
             message rather than an empty scroll area. -->
        <StackPanel Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="360"
                    Visibility="{x:Bind ViewModel.ShowConnectionsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE774;" FontSize="48" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Daemon Not Running"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextAlignment="Center" />
            <TextBlock Text="Start the daemon from General to connect to peers."
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Padding="24"
                      Visibility="{x:Bind ViewModel.ShowConnectionsContent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="18" MaxWidth="640">

                <!-- Section: Connect to host -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Connect to host" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="HostInput"
                                     PlaceholderText="Host or IP address"
                                     TextChanged="OnHostInputChanged"
                                     KeyDown="OnHostInputKeyDown" />
                            <Button Grid.Column="1"
                                    x:Name="ConnectButton"
                                    Content="Connect"
                                    IsEnabled="False"
                                    Click="OnConnectClick" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Section: Incoming requests -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Incoming requests" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Pending, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ipc:PendingInfo">
                                <components:PendingRequestCard Request="{x:Bind}"
                                                               AcceptClicked="OnAcceptClick"
                                                               RejectClicked="OnRejectClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Section: Active sessions -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasSessions, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Active sessions" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ipc:SessionInfo">
                                <components:SessionCard Session="{x:Bind}"
                                                        ActionClicked="OnDisconnectClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Section: Known peers -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasPeers, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Known peers" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Peers, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ipc:PeerInfo">
                                <components:PeerCard Peer="{x:Bind}"
                                                     ActionClicked="OnForgetPeerClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Section: Screen layout — one picker per peer, applied at once. -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasPlacements, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Screen layout" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Placements, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ipc:LayoutInfo">
                                    <components:LayoutRow Placement="{x:Bind}"
                                                          Margin="0,0,0,8"
                                                          EdgeChanged="OnLayoutEdgeChanged" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
