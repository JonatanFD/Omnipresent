<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Omni.App.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <!-- A navigation pane beside a detail pane, with the section name as the
         detail header: the same two-pane shell as the macOS NavigationSplitView.
         The daemon's state is shown as a dot on General and the waiting-request
         count as a badge on Connections, exactly as the macOS sidebar does — no
         separate title bar of its own. -->
    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    AlwaysShowHeader="True"
                    OpenPaneLength="200"
                    ItemInvoked="OnNavItemInvoked">

        <NavigationView.PaneHeader>
            <TextBlock Text="Omnipresent"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="16,8,0,8" />
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Icon="Home" Tag="general"
                                HorizontalContentAlignment="Stretch"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                <NavigationViewItem.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="General" VerticalAlignment="Center" />
                        <Ellipse Grid.Column="1"
                                 Width="8" Height="8"
                                 Margin="0,0,4,0"
                                 VerticalAlignment="Center"
                                 Fill="{x:Bind ViewModel.Connection, Mode=OneWay, Converter={StaticResource ConnectionStatusBrush}}" />
                    </Grid>
                </NavigationViewItem.Content>
            </NavigationViewItem>

            <!-- Globe, not Network: there is no Symbol.Network, and an icon name
                 that does not resolve fails the XAML parse at *runtime*, which
                 takes the whole window down before it can be shown. -->
            <NavigationViewItem Content="Connections" Icon="Globe" Tag="connections">
                <NavigationViewItem.InfoBadge>
                    <controls:InfoBadge
                        Value="{x:Bind ViewModel.PendingCount, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </NavigationViewItem.InfoBadge>
            </NavigationViewItem>

            <NavigationViewItem Content="System" Icon="Setting" Tag="system" />
            <NavigationViewItem Content="Update" Icon="Download" Tag="update" />
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</UserControl>
