<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Omni.App.Components.LabeledRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Label on the left, value on the right: the same arrangement as the
         macOS pane's LabeledContent rows. -->
    <Grid ColumnSpacing="16" MinHeight="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{x:Bind Label, Mode=OneWay}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="1"
                   Text="{x:Bind Value, Mode=OneWay}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   IsTextSelectionEnabled="{x:Bind Selectable, Mode=OneWay}"
                   FontFamily="{x:Bind ValueFontFamily(Monospaced), Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
