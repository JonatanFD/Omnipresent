<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Omni.App.Components.PendingRequestCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Host, then fingerprint, then the two actions underneath: the same
         top-to-bottom order as the macOS "Incoming requests" row, where the
         fingerprint is what the user verifies before accepting. -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind HostLabel(Request), Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{x:Bind FingerprintLabel(Request), Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       IsTextSelectionEnabled="True"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Button Content="Accept" Style="{StaticResource AccentButtonStyle}"
                        Click="OnAcceptClick" />
                <Button Content="Reject" Click="OnRejectClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
